<!--pages/profile/profile.wxml-->
<view class="container">
  <!-- 用户信息 -->
  <view class="profile-header">
    <view class="avatar gradient-gold">
      <image wx:if="{{userInfo && userInfo.avatar}}" class="avatar-img" src="{{userInfo.avatar}}" mode="aspectFill"></image>
      <image wx:else class="icon" src="/images/icon-user.png" mode="aspectFit"></image>
    </view>
    <text class="nickname">{{userInfo && userInfo.nickname ? userInfo.nickname : '未登录'}}</text>
    <view class="login-section" wx:if="{{!isLoggedIn}}">
      <button class="login-btn" bindtap="onLoginTap">微信登录</button>
    </view>
    <view class="logout-section" wx:else>
      <text class="logout-btn" bindtap="onLogoutTap">退出登录</text>
    </view>
  </view>

  <!-- 功能按钮 -->
  <view class="button-section">
    <view class="function-btn" bindtap="onConvertTap">
      <view class="btn-icon gradient-gold">
        <image class="icon" src="/images/icon-calculator.png" mode="aspectFit"></image>
      </view>
      <view class="btn-info flex-1">
        <text class="btn-title">价格换算</text>
        <text class="btn-desc">输入国际金、银价格，自动换算为人民币</text>
      </view>
      <image class="arrow-icon" src="/images/icon-arrow-right.png" mode="aspectFit"></image>
    </view>

    <view class="function-btn" bindtap="onPremiumTap">
      <view class="btn-icon gradient-gray">
        <image class="icon" src="/images/icon-trend.png" mode="aspectFit"></image>
      </view>
      <view class="btn-info flex-1">
        <text class="btn-title">溢价信息</text>
        <text class="btn-desc">查看金、银的溢价率和汇率信息</text>
      </view>
      <image class="arrow-icon" src="/images/icon-arrow-right.png" mode="aspectFit"></image>
    </view>
  </view>
</view>
