/* pages/market/market.wxss */
.container {
  padding: 34rpx;
  padding-top: calc(env(safe-area-inset-top) + 102rpx);
}

/* 走势图区域 */
.chart-section {
  background-color: #242426;
  border-radius: 34rpx;
  padding: 34rpx;
  margin-bottom: 40rpx;
}

.chart-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 27rpx;
}

.chart-title {
  font-size: 30rpx;
  font-weight: 500;
  color: #F5F5F0;
}

.type-switch {
  display: flex;
  background-color: #2A2A2C;
  border-radius: 14rpx;
  padding: 4rpx;
  gap: 4rpx;
}

.switch-item {
  padding: 12rpx 27rpx;
  border-radius: 10rpx;
  font-size: 23rpx;
  color: #6E6E70;
  transition: all 0.3s;
}

.switch-item.active {
  background-color: #C9A962;
  color: #1A1A1C;
  font-weight: 500;
}

.switch-icon-wrapper {
  width: 40rpx;
  height: 40rpx;
  border-radius: 20rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.switch-icon {
  width: 30rpx;
  height: 30rpx;
}

.chart-price-info {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 27rpx;
  padding-bottom: 27rpx;
  border-bottom: 1px solid #2A2A2C;
}

.price-main {
  display: flex;
  flex-direction: column;
  gap: 8rpx;
}

.price-label {
  font-size: 20rpx;
  color: #6E6E70;
}

.price-value {
  font-size: 40rpx;
  font-weight: 600;
}

.price-change {
  display: flex;
  flex-direction: column;
  gap: 8rpx;
  align-items: flex-end;
}

.change-label {
  font-size: 20rpx;
  color: #6E6E70;
}

.change-value {
  font-size: 30rpx;
  font-weight: 500;
}

.chart-container {
  width: 100%;
  height: 400rpx;
  background-color: #1A1A1C;
  border-radius: 17rpx;
  overflow: hidden;
  position: relative;
}

.chart-canvas {
  width: 100%;
  height: 100%;
}

/* 市场列表 */
.market-list {
  display: flex;
  flex-direction: column;
  gap: 20rpx;
}

.market-item {
  background-color: #242426;
  border-radius: 34rpx;
  padding: 34rpx;
  display: flex;
  align-items: center;
  gap: 27rpx;
  transition: all 0.3s;
}

.market-item.active {
  border: 2px solid #C9A962;
  background-color: #2A2A2C;
}

.market-icon {
  width: 81rpx;
  height: 81rpx;
  border-radius: 40rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.market-icon .icon {
  width: 47rpx;
  height: 47rpx;
}

.market-info {
  display: flex;
  flex-direction: column;
  gap: 8rpx;
}

.market-name {
  font-size: 30rpx;
  font-weight: 500;
  color: #F5F5F0;
}


.market-price {
  font-size: 27rpx;
  font-weight: 500;
}

.market-change {
  display: flex;
  flex-direction: column;
  gap: 8rpx;
  align-items: flex-end;
}

.change-text {
  font-size: 23rpx;
  font-weight: 500;
}

.usd-price {
  font-size: 20rpx;
}
