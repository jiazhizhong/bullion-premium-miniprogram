<!--pages/market/market.wxml-->
<view class="container">
  <!-- 实时价格走势图区域 -->
  <view class="chart-section">
    <view class="chart-header">
      <text class="chart-title">实时价格走势图</text>
      <view class="type-switch">
        <view class="switch-item {{currentType === 'gold' ? 'active' : ''}}" 
              data-type="gold" 
              bindtap="onTypeSwitch">
          <view class="switch-icon-wrapper gradient-gold">
            <image class="switch-icon" src="/images/icon-gold.png" mode="aspectFit"></image>
          </view>
        </view>
        <view class="switch-item {{currentType === 'silver' ? 'active' : ''}}" 
              data-type="silver" 
              bindtap="onTypeSwitch">
          <view class="switch-icon-wrapper gradient-gray">
            <image class="switch-icon" src="/images/icon-silver.png" mode="aspectFit"></image>
          </view>
        </view>
      </view>
    </view>
    
    <!-- 当前价格信息 -->
    <view class="chart-price-info">
      <view class="price-main">
        <text class="price-label">当前价格</text>
        <text class="price-value text-accent">
          ¥{{currentType === 'gold' ? marketData.gold.price : marketData.silver.price}}/克
        </text>
      </view>
      <view class="price-change">
        <text class="change-label">涨跌幅</text>
        <text class="change-value {{(currentType === 'gold' ? marketData.gold.changePercent : marketData.silver.changePercent) >= 0 ? 'text-error' : 'text-success'}}">
          {{(currentType === 'gold' ? marketData.gold.changePercent : marketData.silver.changePercent) >= 0 ? '+' : ''}}{{currentType === 'gold' ? marketData.gold.changePercent : marketData.silver.changePercent}}%
        </text>
      </view>
    </view>
    
    <!-- 走势图区域 -->
    <view class="chart-container">
      <canvas 
        canvas-id="priceChart" 
        id="priceChart"
        class="chart-canvas"
        disable-scroll="true">
      </canvas>
    </view>
  </view>

  <!-- 黄金、白银列表 -->
  <view class="market-list">
    <view class="market-item {{currentType === 'gold' ? 'active' : ''}}" bindtap="onGoldTap">
      <view class="market-icon gradient-gold">
        <image class="icon" src="/images/icon-gold.png" mode="aspectFit"></image>
      </view>
      <view class="market-info flex-1">
        <text class="market-price text-accent">¥{{marketData.gold.price}}/克</text>
      </view>
      <view class="market-change">
        <text class="change-text {{marketData.gold.changePercent >= 0 ? 'text-error' : 'text-success'}}">
          {{marketData.gold.changePercent >= 0 ? '+' : ''}}{{marketData.gold.changePercent}}%
        </text>
        <text class="usd-price text-secondary">${{marketData.gold.usdPrice || '2,000'}}</text>
      </view>
    </view>

    <view class="market-item {{currentType === 'silver' ? 'active' : ''}}" bindtap="onSilverTap">
      <view class="market-icon gradient-gray">
        <image class="icon" src="/images/icon-silver.png" mode="aspectFit"></image>
      </view>
      <view class="market-info flex-1">
        <text class="market-price text-secondary">¥{{marketData.silver.price}}/克</text>
      </view>
      <view class="market-change">
        <text class="change-text {{marketData.silver.changePercent >= 0 ? 'text-error' : 'text-success'}}">
          {{marketData.silver.changePercent >= 0 ? '+' : ''}}{{marketData.silver.changePercent}}%
        </text>
        <text class="usd-price text-secondary">${{marketData.silver.usdPrice || '28.50'}}</text>
      </view>
    </view>
  </view>
</view>
