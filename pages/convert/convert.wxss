/* pages/convert/convert.wxss */
.container {
  padding: 34rpx;
  padding-top: calc(env(safe-area-inset-top) + 102rpx);
}

/* 头部 */
.header {
  display: flex;
  align-items: center;
  gap: 27rpx;
  margin-bottom: 40rpx;
  padding: 20rpx 0;
}

.back-btn {
  width: 68rpx;
  height: 68rpx;
  border-radius: 34rpx;
  border: 1px solid #3A3A3C;
  display: flex;
  align-items: center;
  justify-content: center;
}

.back-icon {
  width: 34rpx;
  height: 34rpx;
}

.page-title {
  font-size: 40rpx;
  font-weight: 500;
  color: #F5F5F0;
}

.convert-card {
  background-color: #242426;
  border-radius: 34rpx;
  padding: 40rpx;
}

.convert-section {
  margin-bottom: 40rpx;
}

.convert-section:last-child {
  margin-bottom: 0;
}

.section-header {
  display: flex;
  align-items: center;
  gap: 20rpx;
  margin-bottom: 27rpx;
}

.section-icon {
  width: 68rpx;
  height: 68rpx;
  border-radius: 34rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.section-icon .icon {
  width: 40rpx;
  height: 40rpx;
}

.section-title {
  font-size: 34rpx;
  font-weight: 500;
  color: #F5F5F0;
}

.input-group {
  margin-bottom: 27rpx;
}

.input-label {
  display: block;
  font-size: 23rpx;
  font-weight: 500;
  color: #6E6E70;
  margin-bottom: 20rpx;
}

.result-group {
  margin-top: 27rpx;
}

.result-label {
  display: block;
  font-size: 23rpx;
  font-weight: 500;
  color: #6E6E70;
  margin-bottom: 20rpx;
}

.result-value {
  font-size: 40rpx;
  font-weight: 500;
}
