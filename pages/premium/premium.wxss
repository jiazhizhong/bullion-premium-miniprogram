/* pages/premium/premium.wxss */
.container {
  padding: 34rpx;
  padding-top: calc(env(safe-area-inset-top) + 102rpx);
}

/* 头部 */
.header {
  display: flex;
  align-items: center;
  gap: 27rpx;
  margin-bottom: 40rpx;
  padding: 20rpx 0;
}

.back-btn {
  width: 68rpx;
  height: 68rpx;
  border-radius: 34rpx;
  border: 1px solid #3A3A3C;
  display: flex;
  align-items: center;
  justify-content: center;
}

.back-icon {
  width: 34rpx;
  height: 34rpx;
}

.page-title {
  font-size: 40rpx;
  font-weight: 500;
  color: #F5F5F0;
}

.premium-card {
  background-color: #242426;
  border-radius: 34rpx;
  padding: 40rpx;
  margin-bottom: 40rpx;
}

.form-section {
  margin-bottom: 40rpx;
}

.section-label {
  display: block;
  font-size: 23rpx;
  font-weight: 500;
  color: #6E6E70;
  margin-bottom: 20rpx;
}

.type-group {
  display: flex;
  gap: 20rpx;
}

.type-option {
  flex: 1;
  height: 81rpx;
  border-radius: 27rpx;
  background-color: #2A2A2C;
  border: 1px solid #3A3A3C;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 13rpx;
  font-size: 23rpx;
  color: #6E6E70;
}

.type-option.active {
  background-color: #C9A962;
  border-color: #C9A962;
  color: #1A1A1C;
  font-weight: 500;
}

.radio {
  width: 34rpx;
  height: 34rpx;
  border-radius: 17rpx;
  border: 2px solid #6E6E70;
}

.type-option.active .radio {
  border-color: #1A1A1C;
  background-color: #C9A962;
}

.radio.checked {
  background-color: #1A1A1C;
}

.type-icon-wrapper {
  width: 40rpx;
  height: 40rpx;
  border-radius: 20rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.type-icon {
  width: 30rpx;
  height: 30rpx;
}

.mode-switch {
  display: flex;
  gap: 20rpx;
  margin-top: 13rpx;
  padding: 0 8rpx;
}

.mode-item {
  display: flex;
  align-items: center;
  gap: 10rpx;
  font-size: 20rpx;
  color: #6E6E70;
}

.mode-item.active {
  color: #C9A962;
  font-weight: 500;
}

.mode-icon {
  width: 23rpx;
  height: 23rpx;
}

.input-unit {
  display: block;
  font-size: 23rpx;
  color: #6E6E70;
  margin-top: 13rpx;
}

.calc-btn {
  width: 100%;
  height: 95rpx;
  margin-top: 40rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  text-align: center;
  line-height: 95rpx;
}

/* 确保button文字居中 */
button.calc-btn {
  display: flex;
  align-items: center;
  justify-content: center;
}

button.calc-btn::after {
  border: none;
}

.result-card {
  background-color: #242426;
  border-radius: 34rpx;
  padding: 40rpx;
}

.result-title {
  display: block;
  font-size: 23rpx;
  font-weight: 500;
  color: #6E6E70;
  margin-bottom: 34rpx;
}

.result-row {
  margin-bottom: 34rpx;
}

.result-row:last-child {
  margin-bottom: 0;
}

.result-label {
  font-size: 23rpx;
  color: #6E6E70;
}

.result-value {
  font-size: 23rpx;
  font-weight: 500;
}
