/* pages/assets/add-asset/add-asset.wxss */
.container {
  padding: 34rpx;
  padding-top: calc(env(safe-area-inset-top) + 102rpx);
}

/* 头部 */
.header {
  display: flex;
  align-items: center;
  gap: 27rpx;
  margin-bottom: 40rpx;
  padding: 20rpx 0;
}

.back-btn {
  width: 68rpx;
  height: 68rpx;
  border-radius: 34rpx;
  border: 1px solid #3A3A3C;
  display: flex;
  align-items: center;
  justify-content: center;
}

.back-icon {
  width: 34rpx;
  height: 34rpx;
}

.page-title {
  font-size: 40rpx;
  font-weight: 500;
  color: #F5F5F0;
}

.type-selector {
  display: flex;
  gap: 20rpx;
  margin-bottom: 54rpx;
}

.type-option {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 20rpx;
  padding: 40rpx 0;
  background-color: #242426;
  border-radius: 34rpx;
  font-size: 34rpx;
  font-weight: 500;
  color: #6E6E70;
}

.type-option.active {
  background-color: #C9A962;
  color: #1A1A1C;
}

.type-option.disabled {
  opacity: 0.5;
  pointer-events: none;
}

.type-icon {
  width: 81rpx;
  height: 81rpx;
  border-radius: 40rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.type-icon .icon {
  width: 54rpx;
  height: 54rpx;
}

.form-card {
  background-color: #242426;
  border-radius: 34rpx;
  padding: 40rpx;
  margin-bottom: 40rpx;
}

.form-section {
  margin-bottom: 40rpx;
}

.form-section:last-child {
  margin-bottom: 0;
}

.section-label {
  display: block;
  font-size: 23rpx;
  font-weight: 500;
  color: #6E6E70;
  margin-bottom: 20rpx;
}

.input-unit {
  display: block;
  font-size: 23rpx;
  color: #6E6E70;
  margin-top: 13rpx;
}

.picker-input {
  height: 95rpx;
  background-color: #2A2A2C;
  border: 1px solid #3A3A3C;
  border-radius: 27rpx;
  padding: 0 27rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
  font-size: 30rpx;
}

.arrow-icon,
.calendar-icon {
  width: 34rpx;
  height: 34rpx;
}

.submit-btn {
  width: 100%;
  height: 95rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  text-align: center;
  line-height: 95rpx;
}

/* 确保button文字居中 */
button.submit-btn {
  display: flex;
  align-items: center;
  justify-content: center;
}

button.submit-btn::after {
  border: none;
}
